# The Go backend and Node Sandbox adapter use these server-side only.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://localhost:54329/promptship?sslmode=disable
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
APP_ORIGIN=http://localhost:3000
APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080
# Production: point to a persistent, writable volume for historical runners.
BUNDLE_DIR=

# Next.js proxy target. Never prefix backend credentials with NEXT_PUBLIC_.
API_URL=http://127.0.0.1:8080
